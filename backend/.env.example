# ============================================================
#  ZONA VIP GYM — Variables de entorno
#  Copia este archivo como ".env" para desarrollo local.
#  En Railway estas variables se configuran en la pestaña
#  Variables del servicio (NUNCA subas el .env real a GitHub).
# ============================================================

# Puerto local (Railway lo asigna solo, no hace falta definirlo allá)
PORT=3000

# Conexión a Supabase (Transaction pooler, puerto 6543)
# Formato: postgresql://usuario:contraseña@host:6543/postgres
DATABASE_URL=

# Clave para firmar las sesiones. Genera 64 caracteres aleatorios:
# https://generate-secret.vercel.app/64
JWT_SECRET=

# Contraseña inicial del admin (solo se usa la PRIMERA vez,
# cuando la base de datos está vacía)
ADMIN_PASSWORD=

# Email del admin inicial (opcional, por defecto admin@zonavip.com)
# ADMIN_EMAIL=admin@zonavip.com

# Zona horaria del negocio (opcional, por defecto America/Lima)
# GYM_TZ=America/Lima

# Duración de la sesión (opcional, por defecto 24h)
# TOKEN_TTL=24h

NODE_ENV=production
